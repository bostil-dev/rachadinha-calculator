<mvc:View
        xmlns:form="sap.ui.layout.form"
        controllerName="calculator.controller.MainView"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m">
    <Page
            id="page"
            title="{i18n>MainViewPageTitle}">
        <form:SimpleForm>
            <form:content>
                <Label text="{i18n>MainViewLabelTextRachada}" />
                <Slider
                        id="slider"
                        enableTickmarks="true"
                        min="{rachadinha>/min}"
                        max="{rachadinha>/max}"
                        value="{rachadinha>/percentage}"
                        showAdvancedTooltip="true"
                        showHandleTooltip="false"
                        liveChange=".onRacharContinuamenteAteAPFAparecerPorra" />
                <Label />
                <Button
                        text="{i18n>MainViewButtonText}"
                        press=".onAskQueirozToRachar" />
            </form:content>
        </form:SimpleForm>
        <List
                id="list"
                items="{rachadinha>/council}">
            <headerToolbar>
                <Toolbar>
                    <Title text="{i18n>MainViewTitleTextRachador}" />
                </Toolbar>
            </headerToolbar>
            <items>
                <InputListItem label="{rachadinha>name}">
                    <content>
                        <Input
                                placeholder="{i18n>MainViewInputPlaceholderSalary}"
                                width="10rem"
                                type="Number"
                                value="{rachadinha>salary}"
                                valueLiveUpdate="true"
                                liveChange=".onRacharContinuamenteAteAPFAparecerPorra" />
                    </content>
                </InputListItem>
            </items>
        </List>
        <footer>
            <OverflowToolbar>
                <content>
                    <ToolbarSpacer />
                    <Label text="{i18n>MainViewLabelTextTotal}" />
                    <Title
                            id="title"
                            text="{rachadinha>/total}" />
                </content>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>